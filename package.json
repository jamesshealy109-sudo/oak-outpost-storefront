{
  "name": "oak-outpost-storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "npm run build:node && npm run build:site",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "build:node": "next build",
    "build:site": "node scripts/run-framework.mjs build"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "react-server-dom-webpack": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vinext": "^1.0.0-beta.5",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
