      "css": ".ds-card{font-family:var(--font-sans, \"DM Sans\", sans-serif);max-width:280px;min-width:0;color:var(--forest,#193c2e);background:transparent}.ds-image{display:block;aspect-ratio:4/5;position:relative;overflow:hidden;background:var(--product-neutral,#eae6dc)}.ds-arrow{position:absolute;right:14px;bottom:14px;width:37px;height:37px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--cream,#f7f3e9);transform:translateY(2px);transition:background .25s,color .25s}.ds-card:hover .ds-arrow{background:var(--forest,#193c2e);color:var(--cream,#f7f3e9)}.ds-caption{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding-top:18px;font-size:11px;line-height:1.5}.ds-caption a{font-size:12px;font-weight:600;color:inherit;text-decoration:none}.ds-caption a:hover{text-decoration:underline}.ds-caption span{font-variant-numeric:tabular-nums;white-space:nowrap}.ds-card a:focus-visible{outline:2px solid var(--rust,#ab4c2d);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-arrow{transition:none}}@media(max-width:1100px){.ds-caption{flex-direction:column;gap:5px}}@media(max-width:760px){.ds-caption{padding-top:13px}.ds-caption a{font-size:14px;line-height:1.6}.ds-caption span{font-size:13px;line-height:1.6}.ds-image{aspect-ratio:4/5.2}.ds-arrow{width:30px;height:30px;bottom:10px;right:10px}.ds-arrow svg{width:17px}}"
