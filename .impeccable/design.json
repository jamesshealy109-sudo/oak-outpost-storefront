  "narrative": {
    "northStar": "The Southern Travel Journal",
    "overview": "Warm paper, forest ink, expressive serif headlines, and generously framed apparel photography give Oak & Outpost the character of a Southern travel journal. Supplied oak, heron, and backroad artwork anchors the vintage outdoors identity. Controls remain direct and readable within that editorial world.\n\nThe implementation alternates broad photographic passages with quiet cream shopping surfaces. Product images have their own pale grounds and open captions; border rules organize choices and support content. Motion is restrained and removed for reduced-motion preferences. This system describes the built CSS in `app/globals.css`, the local fonts in `app/layout.tsx`, and the shared storefront components.",
    "keyCharacteristics": [
      "Warm cream surfaces and dark forest text.",
      "Fraunces headings paired with DM Sans commerce controls.",
      "Open product grids with contained merchandise images.",
      "Square buttons and fields, with circular swatches and bag counters.",
      "Shaded photography, subtle image movement, and one sliding bag drawer."
    ],
    "rules": [
      {
        "name": "The Forest Ink Rule",
        "body": "Main reading and purchasing surfaces use forest ink on cream; burnt orange marks emphasis and interaction rather than replacing the reading color.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Fraunces for editorial headings and DM Sans for purchase decisions, product metadata, and controls.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep normal shopping surfaces flat; reserve ambient edge shadows for overlays and selected-state legibility.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve supplied identity artwork and give actual apparel images open, contained space.",
      "Do use Fraunces for editorial headings and DM Sans for shopping and support controls.",
      "Do maintain visible keyboard focus, meaningful selected states, and reduced-motion behavior.",
      "Do use thin rules and pale tonal grounds to structure flat shopping surfaces."
    ],
    "donts": [
      "Don't wrap ordinary product cards in extra rounded, shadowed panels.",
      "Don't crop contained merchandise images merely to fill their image ground.",
      "Don't use decorative glyphs in place of the existing SVG utility icons.",
      "Don't extend the tiny masthead and footer lockup text into a general-purpose reading or control scale."
    ]
  }
}
